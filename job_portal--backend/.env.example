PORT=5000

# Generate a strong random secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<replace_with_a_long_random_secret>

MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mitd9dl.mongodb.net/job_portal?appName=Cluster0

